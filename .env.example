# .env único do projeto: vale para todas as fases.
# Copie para `.env` na raiz (cp .env.example .env) e preencha.
# Os scripts chamam load_dotenv(), que sobe as pastas até achar este arquivo,
# então não é preciso ter um .env dentro de cada fase.

# --- Oracle da FIAP (Fases 3 e 4) ---
ORACLE_USER=RM000000
ORACLE_PASSWORD=sua_senha
ORACLE_DSN=oracle.fiap.com.br:1521/ORCL

# --- API da Fase 4 (lida pela dashboard Streamlit) ---
API_URL=http://127.0.0.1:8000

# --- Alertas na AWS (Fase 7, Parte 2) — serviço em alerta/ ---
# Região onde o tópico SNS (e a Lambda) foram criados. Na entrega usamos us-east-2 (Ohio); no floci tanto faz.
AWS_REGION=us-east-2
# Tópico SNS que recebe os alertas. No floci o ARN é sempre este (troque a região se mudar AWS_REGION); na AWS real copie do console.
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:farmtech-alertas
# Desenvolvimento local no floci (docker compose up -d): com esta linha o boto3 fala com o emulador.
# Para usar a AWS real, comente a linha e preencha as chaves do usuário IAM abaixo.
AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
