# .env único do projeto: vale para todas as fases.
# Copie para `.env` na raiz (cp .env.example .env) e preencha.
# Os scripts chamam load_dotenv(), que sobe as pastas até achar este arquivo,
# então não é preciso ter um .env dentro de cada fase.

# --- Oracle da FIAP (Fases 3 e 4) ---
ORACLE_USER=RM000000
ORACLE_PASSWORD=sua_senha
ORACLE_DSN=oracle.fiap.com.br:1521/ORCL

# --- API da Fase 4 (lida pela dashboard Streamlit) ---
API_URL=http://127.0.0.1:8000

# --- Alertas na AWS (Fase 7, Parte 2) ---
# AWS_REGION=us-east-1
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:farmtech-alertas
# Para testar localmente no floci (docker-compose.yaml), descomente a linha abaixo.
# Sem ela, o boto3 fala com a AWS real.
# AWS_ENDPOINT_URL=http://localhost:4566
